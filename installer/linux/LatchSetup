#!/usr/bin/env sh
set -e

# ==============================================================================
# Latch Universal Linux Bootstrapper Installer
# Standalone executable installer for Latch Desktop on Linux.
# Features:
#   - Auto-detection of existing Latch installations
#   - GUI mode via Zenity if display is available; terminal fallback
#   - Resilient 4-thread parallel chunk download with resume
#   - Automatic reconnect retries on transient connection drops
#   - SHA-256 integrity verification
#   - Credential store & Secret Service keyring wipe on uninstall
# ==============================================================================

REPO="vinnovateit/latch"
ACTION="install"
FORCE_TERMINAL=0

for arg in "$@"; do
    case "$arg" in
        --uninstall|-u) ACTION="uninstall" ;;
        --reinstall|-r) ACTION="reinstall" ;;
        --update) ACTION="update" ;;
        --launch|-l) ACTION="launch" ;;
        --terminal|-t) FORCE_TERMINAL=1 ;;
        --help|-h)
            echo "Usage: LatchSetup [OPTIONS]"
            echo "Options:"
            echo "  -u, --uninstall   Uninstall Latch Desktop and wipe stored credentials"
            echo "  -r, --reinstall   Force re-download and reinstall"
            echo "      --update      Update Latch to latest release"
            echo "  -l, --launch      Launch installed Latch Desktop"
            echo "  -t, --terminal    Force terminal mode (disable GUI dialogs)"
            echo "  -h, --help        Show this help message"
            exit 0
            ;;
    esac
done

# Detect GUI capability
USE_GUI=0
if [ "$FORCE_TERMINAL" -eq 0 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v zenity >/dev/null 2>&1; then
    USE_GUI=1
fi

# Detect existing installation
IS_INSTALLED=0
INSTALLED_LOCATION=""
INSTALLED_VERSION=""

if [ -x "/opt/latch/bin/Latch" ]; then
    IS_INSTALLED=1
    INSTALLED_LOCATION="system"
elif [ -x "$HOME/.local/share/latch/bin/Latch" ]; then
    IS_INSTALLED=1
    INSTALLED_LOCATION="user"
fi

do_uninstall() {
    if [ "$USE_GUI" -eq 1 ]; then
        if ! zenity --question --title="Uninstall Latch" --text="Are you sure you want to uninstall Latch Desktop?" --ok-label="Uninstall" --cancel-label="Cancel" 2>/dev/null; then
            exit 0
        fi
    fi

    echo "==== Uninstalling Latch Desktop ===="
    REMOVED=0

    # Clear Secret Service keyring entry if secret-tool is present
    if command -v secret-tool >/dev/null 2>&1; then
        secret-tool clear service Latch 2>/dev/null || true
    fi

    # Wipe stored credentials and salt files
    DATA_BASE="${XDG_DATA_HOME:-$HOME/.local/share}"
    if [ -d "$DATA_BASE/Latch" ]; then
        rm -f "$DATA_BASE/Latch/credentials.bin"* "$DATA_BASE/Latch/.creds_salt"* 2>/dev/null || true
    fi

    if [ -d "/opt/latch" ] || [ -f "/usr/local/bin/latch" ] || [ -f "/usr/share/applications/latch.desktop" ]; then
        if [ $(id -u) -eq 0 ] || ([ $(id -u) -ne 0 ] && command -v sudo >/dev/null 2>&1 && sudo -v 2>/dev/null); then
            SUDO_CMD=""
            [ $(id -u) -ne 0 ] && SUDO_CMD="sudo"
            $SUDO_CMD rm -rf /opt/latch
            $SUDO_CMD rm -f /usr/local/bin/latch /usr/share/applications/latch.desktop
            echo "--> Removed system-wide installation (/opt/latch)."
            REMOVED=1
        fi
    fi

    if [ -d "$HOME/.local/share/latch" ] || [ -f "$HOME/.local/bin/latch" ] || [ -f "$HOME/.local/share/applications/latch.desktop" ]; then
        rm -rf "$HOME/.local/share/latch"
        rm -f "$HOME/.local/bin/latch" "$HOME/.local/share/applications/latch.desktop"
        echo "--> Removed user installation (~/.local/share/latch)."
        REMOVED=1
    fi

    if [ "$REMOVED" -eq 1 ]; then
        echo "==== Latch Desktop successfully uninstalled! ===="
        if [ "$USE_GUI" -eq 1 ]; then
            zenity --info --title="Uninstall Complete" --text="Latch Desktop was uninstalled successfully" 2>/dev/null || true
        fi
    else
        echo "No existing Latch Desktop installation found to remove."
        if [ "$USE_GUI" -eq 1 ]; then
            zenity --info --title="Uninstall" --text="No existing Latch Desktop installation found" 2>/dev/null || true
        fi
    fi
    exit 0
}

do_launch() {
    if [ "$INSTALLED_LOCATION" = "system" ]; then
        exec /opt/latch/bin/Latch
    elif [ "$INSTALLED_LOCATION" = "user" ]; then
        exec "$HOME/.local/share/latch/bin/Latch"
    elif command -v latch >/dev/null 2>&1; then
        exec latch
    else
        echo "ERROR: Latch Desktop is not installed." >&2
        if [ "$USE_GUI" -eq 1 ]; then
            zenity --error --title="Launch Failed" --text="Latch Desktop is not installed" 2>/dev/null || true
        fi
        exit 1
    fi
}

if [ "$ACTION" = "uninstall" ]; then
    do_uninstall
fi

if [ "$ACTION" = "launch" ]; then
    do_launch
fi

# Up-to-date handling if already installed
if [ "$IS_INSTALLED" -eq 1 ] && [ "$ACTION" = "install" ]; then
    if [ "$USE_GUI" -eq 1 ]; then
        CHOICE=$(zenity --list --title="Latch Setup" --text="Latch Desktop is already installed ($INSTALLED_LOCATION)" \
            --column="Action" --column="Description" \
            "Launch" "Open Latch Desktop" \
            "Reinstall" "Re-download and reinstall latest version" \
            "Uninstall" "Remove Latch and wipe saved credentials" \
            --hide-header --height=220 --width=380 2>/dev/null || true)

        case "$CHOICE" in
            Launch) do_launch ;;
            Reinstall) ACTION="reinstall" ;;
            Uninstall) do_uninstall ;;
            *) exit 0 ;;
        esac
    elif [ -t 0 ] && [ $# -eq 0 ]; then
        echo "==== Latch Desktop is already installed ($INSTALLED_LOCATION) ===="
        echo "1) Update / Reinstall Latch"
        echo "2) Launch Latch"
        echo "3) Uninstall Latch"
        echo "4) Exit"
        printf "Choose an option [1-4]: "
        read choice || choice=""
        case "$choice" in
            1) ACTION="reinstall" ;;
            2) do_launch ;;
            3) do_uninstall ;;
            *) exit 0 ;;
        esac
    fi
fi

# Resolve release info from GitHub API with retry
resolve_release_info() {
    RELEASE_JSON=""
    for attempt in 1 2 3; do
        RELEASE_JSON=$(curl -fsSL --retry 2 "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null || true)
        [ -n "$RELEASE_JSON" ] && break
        sleep 1
    done

    TAR_URL=""
    EXPECTED_SHA256=""
    EXPECTED_SIZE=""
    TAG_VERSION=""

    if [ -n "$RELEASE_JSON" ]; then
        TAR_URL=$(echo "$RELEASE_JSON" | grep '"browser_download_url"' | grep '/latch-[0-9][^"/]*-linux-x64\.tar\.gz"' | cut -d '"' -f 4 | head -n 1) || true
        EXPECTED_SHA256=$(echo "$RELEASE_JSON" | grep -A 8 'latch-[0-9][^"/]*-linux-x64\.tar\.gz' | grep '"digest"' | cut -d '"' -f 4 | sed 's/sha256://' | head -n 1) || true
        EXPECTED_SIZE=$(echo "$RELEASE_JSON" | grep -A 8 'latch-[0-9][^"/]*-linux-x64\.tar\.gz' | grep '"size"' | tr -dc '0-9' | head -n 1) || true
        TAG_VERSION=$(echo "$RELEASE_JSON" | grep '"tag_name"' | cut -d '"' -f 4 | sed 's/^v//' | head -n 1) || true
    fi

    if [ -z "$TAR_URL" ]; then
        latest=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest" 2>/dev/null) || true
        tag=${latest##*/}
        case "$tag" in
            v[0-9]*)
                TAR_URL="https://github.com/${REPO}/releases/download/${tag}/latch-${tag#v}-linux-x64.tar.gz"
                TAG_VERSION="${tag#v}"
                ;;
            *) return 1 ;;
        esac
    fi

    echo "$TAR_URL"
    return 0
}

# 4-thread parallel chunk downloader with resume and reconnect retries
download_tarball() {
    url="$1"
    target="$2"
    expected_size="$3"

    single_fallback() {
        curl -fsSL -C - --retry 8 --retry-delay 2 "$url" -o "$target"
    }

    size="$expected_size"
    if [ -z "$size" ] || [ "$size" -le 0 ]; then
        size=$(curl -fsSLI "$url" 2>/dev/null | tr -d '\r' | grep -i '^Content-Length:' | tail -n1 | awk '{print $2}' || true)
    fi

    if [ -z "$size" ] || [ "$size" -lt 4194304 ]; then
        single_fallback
        return $?
    fi

    threads=4
    chunk_size=$((size / threads))
    pids=""

    for i in 0 1 2 3; do
        part="${target}.part${i}"
        start=$((i * chunk_size))
        if [ "$i" -eq 3 ]; then
            end=$((size - 1))
        else
            end=$((start + chunk_size - 1))
        fi

        chunk_len=$((end - start + 1))
        existing=0
        if [ -f "$part" ]; then
            existing=$(wc -c < "$part" 2>/dev/null || stat -c%s "$part" 2>/dev/null || echo 0)
        fi

        if [ "$existing" -ge "$chunk_len" ]; then
            continue
        fi

        (
            retries=0
            while [ "$existing" -lt "$chunk_len" ] && [ "$retries" -lt 8 ]; do
                req_start=$((start + existing))
                chunk_tmp="${part}.chunk"
                if curl -fsSL -r "${req_start}-${end}" "$url" -o "$chunk_tmp" 2>/dev/null; then
                    cat "$chunk_tmp" >> "$part"
                    rm -f "$chunk_tmp"
                    break
                else
                    rm -f "$chunk_tmp"
                    retries=$((retries + 1))
                    sleep 1
                    existing=$(wc -c < "$part" 2>/dev/null || stat -c%s "$part" 2>/dev/null || echo 0)
                fi
            done
            [ "$retries" -lt 8 ]
        ) &
        pids="$pids $!"
    done

    failed=0
    for pid in $pids; do
        if ! wait "$pid"; then
            failed=1
        fi
    done

    if [ "$failed" -eq 0 ]; then
        cat "${target}.part0" "${target}.part1" "${target}.part2" "${target}.part3" > "$target" 2>/dev/null
        rm -f "${target}.part"*
        return 0
    else
        rm -f "${target}.part"*
        single_fallback
        return $?
    fi
}

echo "Initialising"

if ! command -v curl >/dev/null 2>&1; then
    echo "ERROR: curl is required to download Latch." >&2
    if [ "$USE_GUI" -eq 1 ]; then
        zenity --error --title="Setup Error" --text="curl is required to download Latch" 2>/dev/null || true
    fi
    exit 1
fi

if ! TAR_URL=$(resolve_release_info); then
    echo "ERROR: Could not find the latest Latch release on GitHub." >&2
    if [ "$USE_GUI" -eq 1 ]; then
        zenity --error --title="Setup Error" --text="Could not find the latest Latch release on GitHub. Please check your network connection." 2>/dev/null || true
    fi
    exit 1
fi

TMP_TAR=$(mktemp /tmp/latch-XXXXXX.tar.gz)
trap 'rm -f "$TMP_TAR" "${TMP_TAR}.part"*' EXIT

echo "--> Downloading latest release..."
download_tarball "$TAR_URL" "$TMP_TAR" "$EXPECTED_SIZE"

if [ -n "$EXPECTED_SHA256" ]; then
    ACTUAL_SHA256=""
    if command -v sha256sum >/dev/null 2>&1; then
        ACTUAL_SHA256=$(sha256sum "$TMP_TAR" 2>/dev/null | awk '{print $1}')
    elif command -v shasum >/dev/null 2>&1; then
        ACTUAL_SHA256=$(shasum -a 256 "$TMP_TAR" 2>/dev/null | awk '{print $1}')
    fi
    if [ -n "$ACTUAL_SHA256" ] && [ "$ACTUAL_SHA256" != "$EXPECTED_SHA256" ]; then
        echo "ERROR: SHA-256 verification failed (expected $EXPECTED_SHA256, got $ACTUAL_SHA256)" >&2
        if [ "$USE_GUI" -eq 1 ]; then
            zenity --error --title="Security Error" --text="SHA-256 verification failed. Download may be corrupted." 2>/dev/null || true
        fi
        exit 1
    fi
fi

USE_SUDO=0
if [ $(id -u) -ne 0 ] && command -v sudo >/dev/null 2>&1; then
    if sudo -v 2>/dev/null; then
        USE_SUDO=1
    fi
fi

echo "--> Installing..."
if [ $(id -u) -eq 0 ] || [ $USE_SUDO -eq 1 ]; then
    SUDO_CMD=""
    [ $USE_SUDO -eq 1 ] && SUDO_CMD="sudo"

    $SUDO_CMD mkdir -p /opt/latch /usr/local/bin /usr/share/applications
    $SUDO_CMD tar -xzf "$TMP_TAR" -C /opt/latch --strip-components=1 2>/dev/null || $SUDO_CMD tar -xzf "$TMP_TAR" -C /opt/latch
    $SUDO_CMD ln -sf /opt/latch/bin/Latch /usr/local/bin/latch

    $SUDO_CMD tee /usr/share/applications/latch.desktop >/dev/null <<EOF
[Desktop Entry]
Name=Latch
Comment=VIT Hostel Wi-Fi Auto-Login
Exec=/opt/latch/bin/Latch
Icon=/opt/latch/lib/Latch.png
Terminal=false
Type=Application
Categories=Network;Utility;
EOF
else
    LOCAL_OPT="$HOME/.local/share/latch"
    LOCAL_BIN="$HOME/.local/bin"
    LOCAL_APPS="$HOME/.local/share/applications"

    mkdir -p "$LOCAL_OPT" "$LOCAL_BIN" "$LOCAL_APPS"
    tar -xzf "$TMP_TAR" -C "$LOCAL_OPT" --strip-components=1 2>/dev/null || tar -xzf "$TMP_TAR" -C "$LOCAL_OPT"
    ln -sf "$LOCAL_OPT/bin/Latch" "$LOCAL_BIN/latch"

    cat <<EOF > "$LOCAL_APPS/latch.desktop"
[Desktop Entry]
Name=Latch
Comment=VIT Hostel Wi-Fi Auto-Login
Exec=$LOCAL_OPT/bin/Latch
Icon=$LOCAL_OPT/lib/Latch.png
Terminal=false
Type=Application
Categories=Network;Utility;
EOF
fi

echo "==== Latch Desktop successfully installed! ===="
if [ "$USE_GUI" -eq 1 ]; then
    if zenity --question --title="Installation Complete" --text="Latch Desktop was installed successfully!\n\nWould you like to launch Latch now?" --ok-label="Launch" --cancel-label="Close" 2>/dev/null; then
        do_launch
    fi
else
    echo "Launch from your application menu or run 'latch' in terminal."
fi
