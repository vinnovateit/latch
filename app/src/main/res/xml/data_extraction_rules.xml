<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_prefs.xml"/>
        <exclude domain="sharedpref" path="latch_encrypted_credentials.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="latch_verbose.log"/>
        <exclude domain="file" path="latch_verbose.log.old"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_prefs.xml"/>
        <exclude domain="sharedpref" path="latch_encrypted_credentials.xml"/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="latch_verbose.log"/>
        <exclude domain="file" path="latch_verbose.log.old"/>
    </device-transfer>
</data-extraction-rules>
